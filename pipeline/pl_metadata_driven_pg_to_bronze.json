{
	"name": "pl_metadata_driven_pg_to_bronze",
	"properties": {
		"activities": [
			{
				"name": "fe_each_source_table",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.p_table_list",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "lkp_get_watermark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "PostgreSqlV2Source",
									"query": {
										"value": "@concat(\n    'SELECT last_processed_id FROM retail.etl_watermark WHERE table_name = ''',\n    item().table_name,\n    ''''\n)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00"
								},
								"dataset": {
									"referenceName": "ds_pg_etl_watermark",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "cpy_pg_to_bronze_dynamic",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "lkp_get_watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "PostgreSqlV2Source",
									"query": "@concat(\n    'SELECT * FROM ',\n    item().schema_name,\n    '.',\n    item().table_name,\n    ' WHERE ',\n    item().primary_key,\n    ' > ',\n    string(activity('lkp_get_watermark').output.firstRow.last_processed_id),\n    ' ORDER BY ',\n    item().primary_key\n)",
									"queryTimeout": "02:00:00"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_pg_retail_source",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_bronze",
									"type": "DatasetReference",
									"parameters": {
										"p_folder_name": {
											"value": "@item().folder_name",
											"type": "Expression"
										},
										"p_file_name": "@concat(item().table_name,'.parquet')"
									}
								}
							]
						},
						{
							"name": "scr_update_watermark",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "cpy_pg_to_bronze_dynamic",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"scripts": [],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "sp_update_watermark",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "scr_update_watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": []
						}
					]
				}
			}
		],
		"parameters": {
			"p_table_list": {
				"type": "array",
				"defaultValue": [
					{
						"schema_name": "retail",
						"table_name": "customers",
						"folder_name": "customers",
						"primary_key": "customer_id"
					},
					{
						"schema_name": "retail",
						"table_name": "products",
						"folder_name": "products",
						"primary_key": "product_id"
					},
					{
						"schema_name": "retail",
						"table_name": "orders",
						"folder_name": "orders",
						"primary_key": "order_id"
					},
					{
						"schema_name": "retail",
						"table_name": "order_items",
						"folder_name": "order_items",
						"primary_key": "order_item_id"
					},
					{
						"schema_name": "retail",
						"table_name": "payments",
						"folder_name": "payments",
						"primary_key": "payment_id"
					}
				]
			}
		},
		"annotations": []
	}
}